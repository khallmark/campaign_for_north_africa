        "E8": {
          "stage": 7,
          "title": "Remaining scenarios and the campaign"
        },
        "E9": {
          "stage": 8,
          "title": "Final integration and certification"
        }
      }
    }
  ],
  "rules": {
    "edges": "consumer depends on producer. Local blocked_by at every level; a container is complete only when all its children are; a child cannot start before its containers' blockers are complete; cross_project_edges are leaf-to-leaf.",
    "stage_order": "For every dependency u->v resolved to epics eu, ev: stage(ev) <= stage(eu); within one project also epic number(ev) <= epic number(eu). Stages are ordinals, not dates.",
    "corrections": "Defects found downstream become new forward producer leaves with new content versions; never new blockers on completed upstream milestones.",
    "ownership": "Each path has exactly one owning project. A leaf's files_hint must be owned by its project unless listed in scaffold_exceptions.",
    "tools": "A verification command must only use harnesses that exist in the repo or are produced by the leaf itself or a transitive prerequisite (tool_prerequisites plus generic bin/test/schema rules in the validator)."
  },

        "E2": {
          "stage": 1,
          "title": "Contracts, rules ledger, adjudications and source comparisons"
        },
        "E3": {
          "stage": 2,
          "title": "Deterministic foundation: state, phases, projection, saves, import and modes"
        },
        "E4": {
          "stage": 3,
          "title": "Detailed logistics with maneuver"
        },
        "E5": {
          "stage": 4,
          "title": "Land combat and remaining land rules"
        },
        "E6": {
          "stage": 5,
          "title": "Graziani's Offensive bounded acceptance"

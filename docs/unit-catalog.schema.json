{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CNA source catalog v1",
  "type": "object",
  "required": ["schema_version", "title", "coverage", "sources", "stat_definitions", "sprites", "unit_types", "profiles", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string"},
    "coverage": {
      "type": "object",
      "required": ["status", "complete_historical_roster", "summary", "gaps", "counts"],
      "properties": {
        "status": {"type": "string"},
        "complete_historical_roster": {"const": false},
        "summary": {"type": "string"},
        "gaps": {"type": "array", "items": {"type": "string"}},
        "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "path", "section", "pdf_page", "lines", "note"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string"},
          "path": {"type": "string", "pattern": "^docs/"},
          "section": {"type": "string"},
          "pdf_page": {"type": ["integer", "null"], "minimum": 1, "maximum": 192},
          "lines": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}]},
          "note": {"type": "string"}
        }
      }
    },
    "stat_definitions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "unit", "description", "source_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1}, "name": {"type": "string"},
          "unit": {"type": "string"}, "description": {"type": "string"},
          "source_refs": {"$ref": "#/$defs/refs"}
        }
      }
    },
    "sprites": {
      "type": "array", "minItems": 1,
      "items": {"allOf": [{"$ref": "#/$defs/sprite"}, {"required": ["id", "note"], "properties": {"id": {"$ref": "#/$defs/id"}, "note": {"type": "string"}}}]}
    },
    "unit_types": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "domain", "category", "sprite_id", "source_refs"],
        "properties": {
          "id": {"$ref": "#/$defs/id"}, "name": {"type": "string"},
          "domain": {"enum": ["land", "air", "sea"]}, "category": {"type": "string"},
          "sprite_id": {"$ref": "#/$defs/id"}, "source_refs": {"$ref": "#/$defs/refs"}
        }
      }
    },
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/row"},
          {
            "required": ["kind", "profile_id", "playable"],
            "properties": {
              "kind": {"enum": ["unit_type", "formation", "counter_formation", "equipment", "aircraft_configuration", "ground_support", "naval_unit", "support_unit"]},
              "profile_id": {"type": ["string", "null"]},
              "playable": {"const": false}
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "sprite": {
      "type": "object", "required": ["path", "native_facing_degrees", "directional"],
      "properties": {
        "path": {"type": "string", "pattern": "^/sprites/[a-z0-9-]+\\.png$"},
        "native_facing_degrees": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
        "directional": {"type": "boolean"}
      }
    },
    "stat": {
      "type": "object", "required": ["value", "status", "source_refs", "note", "raw", "conditional"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "status": {"enum": ["sourced", "not_applicable", "unresolved", "provisional"]},
        "source_refs": {"$ref": "#/$defs/refs"},
        "note": {"type": "string"}, "raw": {"type": "string"}, "conditional": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "sourced"}}}, "then": {"properties": {"value": {"type": "number"}}}, "else": {"properties": {"value": {"type": "null"}}}}
      ]
    },
    "row": {
      "type": "object", "required": ["id", "name", "nationality", "side", "unit_type", "verification", "source_refs", "stats", "sprite", "note"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1},
        "nationality": {"type": "string"}, "side": {"enum": ["allied", "axis", "unspecified"]},
        "unit_type": {"$ref": "#/$defs/id"},
        "verification": {"enum": ["verified", "partial", "unverified_ocr", "provisional"]},
        "source_refs": {"$ref": "#/$defs/refs"},
        "stats": {"type": "object", "additionalProperties": {"$ref": "#/$defs/stat"}},
        "sprite": {"$ref": "#/$defs/sprite"}, "note": {"type": "string"}
      }
    }
  }
}

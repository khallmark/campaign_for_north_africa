{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CNA distinct identity artwork inventory v1",
  "type": "object",
  "required": ["schema_version", "coverage", "atlas_contract", "entries", "source_row_map", "prototype_mappings", "identity_redirects"],
  "properties": {
    "schema_version": {"const": 1},
    "coverage": {"type": "object", "required": ["complete", "note"], "properties": {"complete": {"const": false}, "note": {"type": "string"}}},
    "atlas_contract": {
      "type": "object",
      "required": ["frame_count", "columns", "rows", "cell_width", "cell_height", "heading_step_degrees", "first_heading_degrees", "rendering"],
      "properties": {
        "frame_count": {"const": 18}, "columns": {"const": 6}, "rows": {"const": 3},
        "cell_width": {"const": 256}, "cell_height": {"const": 256},
        "heading_step_degrees": {"const": 20}, "first_heading_degrees": {"const": 0},
        "rendering": {"const": "frame-selection-only"}
      }
    },
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "identity_redirects": {"type": "object", "additionalProperties": {"type": "string"}},
    "source_row_map": {"type": "object", "additionalProperties": {"type": "string"}},
    "prototype_mappings": {"type": "array", "items": {"type": "object", "required": ["prototype_id", "identity_id", "status", "note"], "properties": {"prototype_id": {"type": "string"}, "identity_id": {"type": ["string", "null"]}, "status": {"type": "string"}, "note": {"type": "string"}}}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "name", "role_id", "side", "entity_kind", "identity_status", "source_entry_ids", "source_refs", "sprite"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "role_id": {"type": ["string", "null"]},
        "side": {"enum": ["allied", "axis", "unspecified"]},
        "entity_kind": {"enum": ["formation_candidate", "ground_support_unit", "naval_unit", "support_unit", "equipment_model_candidate", "aircraft_model"]},
        "identity_status": {"enum": ["provisional", "source_identified", "alias_resolved"]},
        "source_entry_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "sprite": {
          "type": "object",
          "required": ["portrait_path", "atlas_path", "status"],
          "properties": {
            "portrait_path": {"type": ["string", "null"]},
            "atlas_path": {"type": ["string", "null"]},
            "status": {"enum": ["missing", "candidate", "ready"]}
          },
          "allOf": [
            {"if": {"properties": {"status": {"const": "missing"}}}, "then": {"properties": {"portrait_path": {"type": "null"}, "atlas_path": {"type": "null"}}}},
            {"if": {"properties": {"status": {"const": "ready"}}}, "then": {"properties": {"portrait_path": {"type": "string", "pattern": "^/sprites/units/"}, "atlas_path": {"type": "string", "pattern": "^/sprites/units/"}}}}
          ]
        }
      }
    }
  }
}
